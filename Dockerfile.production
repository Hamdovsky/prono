# ─────────────────────────────────────────────────────────
# Dockerfile.production — Node/Express server + React frontend
# Multi-stage build :
#   Stage 1 : npm ci (toutes les deps, dev incluses) + vite build
#   Stage 2 : deps production + dist copié depuis le stage 1
# ─────────────────────────────────────────────────────────

# ── Stage 1: Build React frontend ──
FROM node:22-slim AS frontend-builder
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json* ./
RUN npm ci
COPY vite.config.mjs ./
COPY index.html ./
COPY public/ ./public/
COPY src/ ./src/
RUN npm run build

# ── Stage 2: Production server ──
FROM node:22-slim
WORKDIR /app

# Python3 + venv pour les éviter les bypass anti-bot (Sofascore, Flashscore,
# BetExplorer via curl_cffi — PAS de Puppeteer/Chromium sur Render).
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm rebuild better-sqlite3

COPY . .
COPY --from=frontend-builder /app/dist ./dist

# venv Python partagé : chemin attendu par services/scrapers/SofascoreBypass.js
# et scripts/*.py (pickPython()). curl_cffi requis pour le TLS impersonation.
COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt
ENV PATH="/opt/venv/bin:$PATH"

RUN mkdir -p /app/logs /app/data

ENV NODE_ENV=production
ENV PORT=10000
ENV META_REFINER_PY=on

EXPOSE 10000

CMD node --max-old-space-size=384 server.js
