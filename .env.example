# ==========================================
# STITCH / TITANIUM AI — Environment Variables
# ==========================================
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ─── Database (Supabase / Neon / PostgreSQL) ───
# Get from: Supabase Dashboard → Settings → Database → Connection pooling
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=5
DATABASE_URL=

# Alternative: Direct connection (no pooling) — for migrations only
# DATABASE_URL_DIRECT=

# ─── Redis (Render Key Value or Upstash) ───
REDIS_URL=

# ─── AI / LLM APIs ───
GROQ_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=

# ─── Football Data APIs ───
FOOTBALLDATA_ENABLED=true
FOOTBALLDATA_KEY=
FOOTBALLDATA_HOST=footballdata.io
FOOTBALLDATA_DAILY_LIMIT=20

RAPIDAPI_ENABLED=true
RAPIDAPI_KEY=
RAPIDAPI_HOST=sportapi7.p.rapidapi.com
RAPIDAPI_DAILY_LIMIT=20

# ─── External APIs (set manually on Render dashboard) ───
BSD_API_KEY=
THERUNDOWN_KEY=
ODDSPAPI_KEY=
SPORTMONKS_KEY=
APIFOOTBALL_KEY=
OPENWEATHER_KEY=
OPENLIGADB_ENABLED=true

# ─── Supabase (already in render.yaml) ───
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ───
API_SECRET_KEY=
JWT_SECRET=

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Python FastAPI Inference ───
INFERENCE_URL=https://prono-fastapi.onrender.com

# ─── Serverless Scraper Worker ───
SCRAPER_WORKER_URL=https://prono-scraper.onrender.com

# ─── Node/Environment ───
NODE_ENV=development
NODE_VERSION=20
VITE_API_URL=http://localhost:3001

# ─── Scraper ───
HTTP_SCRAPER_ENABLED=true
PUPPETEER_SKIP_DOWNLOAD=true
REDISMS_DISABLE_POSTINSTALL=true

# ─── Feature Flags ───
ENABLE_PREDICTION_ENRICHMENT=true
ENABLE_LIVE_PREDICTIONS=true
ENABLE_AUTO_LEARNING=true