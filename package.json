{
  "name": "stitch",
  "version": "1.0.0",
  "description": "Titanium AI — Football prediction engine",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0 <23"
  },
  "scripts": {
    "start": "node --max-old-space-size=512 server.js",
    "dev": "concurrently \"npm run server\" \"vite\" --names \"api,vite\" --prefix-colors \"cyan,magenta\"",
    "server": "node --max-old-space-size=512 server.js",
    "scraper": "node SofascoreScraping/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:optimize": "node scripts/optimize_db.js",
    "sportdb:import": "node scripts/import_sportdb_history.js",
    "learn": "node scripts/adaptive_learning_sync.js",
    "autolearn": "python scripts/train_xgboost.py",
    "online:update": "node scripts/online_learning_update.js",
    "dispatch": "node scripts/surgical_daily_dispatch.js",
    "results": "node scripts/surgical_results_report.js",
    "seed": "node scripts/seed_emergency.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:python": "python -m pytest tests/ -v",
    "cleanup:dry": "node archive/scripts_legacy/cleanup_root.js --dry",
    "cleanup": "node archive/scripts_legacy/cleanup_root.js",
    "optimize": "npm run db:optimize && npm run build"
  },
  "keywords": [
    "football",
    "prediction",
    "ai",
    "machine-learning"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.3",
    "async-retry": "^1.3.3",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bottleneck": "^2.19.5",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "fast-json-patch": "^3.1.1",
    "framer-motion": "^12.34.3",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.575.0",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1",
    "pg": "^8.22.0",
    "prom-client": "^15.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0",
    "react-window": "^2.2.7",
    "recharts": "^3.9.2",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "telegram": "^2.26.22",
    "terser": "^5.46.0",
    "undici": "^8.1.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "redis-memory-server": "^0.16.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
