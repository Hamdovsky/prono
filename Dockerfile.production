# ─── Stage 1: Node.js dependencies ───────────────────────────
FROM node:18-slim AS node-deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --only=production
RUN npm rebuild better-sqlite3

# ─── Stage 2: Frontend build ────────────────────────────────
FROM node:18-slim AS frontend-build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --only=production
COPY vite.config.js index.html ./
COPY src/ ./src/
COPY public/ ./public/
RUN npm run build

# ─── Stage 3: Production image ──────────────────────────────
FROM python:3.11-slim
WORKDIR /app

# Install Node.js 18 (official NodeSource)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python ML / data deps
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        numpy==1.26.4 \
        pandas==3.0.2 \
        scipy==1.17.1 \
        xgboost==2.1.0 \
        scikit-learn==1.8.0 \
        joblib==1.5.3 \
        optuna>=4.0.0 \
        matplotlib==3.10.8 \
        seaborn>=0.13.0 \
        requests==2.33.1 \
        beautifulsoup4>=4.12.0

# Copy Node.js deps
COPY --from=node-deps /app/node_modules ./node_modules
# Copy frontend build
COPY --from=frontend-build /app/dist ./dist

# Copy application code
COPY package.json package-lock.json* ./
COPY app.js server.js ./
COPY core/ ./core/
COPY routes/ ./routes/
COPY services/ ./services/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY data/ ./data/
COPY models/ ./models/
COPY inference/ ./inference/

# Create required directories
RUN mkdir -p /app/logs /app/data

# Environment
ENV NODE_ENV=production
ENV PORT=10000
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/core:/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:10000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

EXPOSE 10000

CMD python scripts/import_promosport_archive.py && node scripts/backfill_promosport_predictions.js && node --max-old-space-size=512 server.js
