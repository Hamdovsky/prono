# ═══════════════════════════════════════════════════════════
# TITANIUM AI - Stitch System — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────
PORT=10000
NODE_ENV=development

# ─── Authentication ────────────────────────────────────────
# ⚠️  CHANGE THIS IMMEDIATELY before deploying!
# Use: openssl rand -hex 32
API_SECRET_KEY=CHANGER_MOI

# ─── Database ──────────────────────────────────────────────
# PostgreSQL (Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ─────────────────────────────────────────────────
# Render Key Value or local Redis
REDIS_URL=rediss://default:token@host:6379

# ─── Telegram Bot ──────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── External APIs (Sports Data) ──────────────────────────
# Register at each service to get free API keys
BSD_API_KEY=
BBS_API_KEY=
PREDIXSPORT_API_KEY=
ODDSAPI_IO_KEY=
FOOTBALL_DATA_API_KEY=
SPORTSDATA_IO_KEY=
SPORTSRC_API_KEY=
THERUNDOWN_KEY=
ODDSPAPI_KEY=
APIFOOTBALL_KEY=

# ─── External APIs (Utility) ──────────────────────────────
OPENWEATHERMAP_API_KEY=
FIRECRAWL_API_KEY=

# ─── ML Inference ──────────────────────────────────────────
# URL of the deployed FastAPI service
FASTAPI_URL=http://127.0.0.1:8000
INFERENCE_URL=http://127.0.0.1:8000
USE_MODEL_MANAGER=true

# ─── Frontend ──────────────────────────────────────────────
FRONTEND_URL=https://prono-k6gc.onrender.com
VITE_API_URL=https://prono-k6gc.onrender.com

# ─── Performance ──────────────────────────────────────────
ENRICH_BATCH_SIZE=20
ENRICH_BATCH_DELAY_MS=300000
NODE_OPTIONS=--max-old-space-size=384
