FROM node:22-slim
WORKDIR /app

# Build tools for better-sqlite3 native addon + Python for import/retrain scripts
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv build-essential \
    && ln -s /usr/bin/python3 /usr/bin/python \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Pre-install ML packages (avoid self-bootstrap pip timeout at runtime)
RUN pip3 install --no-cache-dir pandas numpy scikit-learn xgboost joblib optuna && python3 -c "import pandas, numpy, sklearn, xgboost, joblib, optuna; print('ML deps OK')"

COPY package.json package-lock.json* ./
RUN npm ci --only=production && npm rebuild better-sqlite3
COPY . .
RUN npm rebuild better-sqlite3
RUN mkdir -p /app/logs /app/data

ENV NODE_ENV=production
ENV PORT=10000
ENV PYTHONUNBUFFERED=1

EXPOSE 10000

CMD node --max-old-space-size=512 server.js
