# ─── Server ─────────────────────────────
PORT=10000
NODE_ENV=development

# ─── Authentication ─────────────────────
API_SECRET_KEY=CHANGER_MOI

# ─── Database ────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Maintenance DB ──────────────────────
# Rétention des matchs non-live (jours) avant purge automatique quotidienne.
STALE_MATCH_RETENTION_DAYS=7
# Expression cron (UTC? non, Europe/Paris) de la purge quotidienne des matchs périmés.
STALE_MATCH_CLEANUP_CRON=0 6 * * *

# ─── Redis ───────────────────────────────
REDIS_URL=rediss://default:token@host:6379

# ─── External APIs ──────────────────────
# (see Render Dashboard for full list)

# ─── Odds — sources 100% GRATUITES (recommandé) ──────
# Sofascore public odds — Aucune clé requise. Best-effort (IP du déploiement
# doit accéder à api.sofascore.com). Activé par défaut.
SOFASCORE_ODDS_ENABLED=true
# Désactive TOUT accès Sofascore (dont le scraper Puppeteer) si bloqué sur Render.
DISABLE_SOFASCORE=false
# Cooldown global (ms) après un blocage 403/429 — par défaut 8 min. Augmenter
# si l'IP du déploiement se fait bannir.
SOFASCORE_COOLDOWN_MS=480000

# Odds API.io — plan GRATUIT (500 requêtes/mois environ), clé requise.
ODDSAPI_IO_ENABLED=true
ODDSAPI_IO_KEY=

# ─── Sources FIXTURES/Elo — 100% GRATUITES (aucune clé) ──────
# OpenLigaDB — ligues allemandes + Champions/Europa League, sans clé.
OPENLIGADB_ENABLED=true
# SportScore — scores en direct, sans clé (10k requêtes/jour).
SPORTSCORE_ENABLED=true
# BetExplorer — cotes, sans clé (nécessite un bypass web/Puppeteer local).
BETEXPLORER_ENABLED=true
# Football-Data UK (football-data.co.uk) — CSV résultats + cotes + stats,
# exécuté par le pipeline Python (data_pipeline/run_daily.py), sans clé.
# Planifié via la tâche Windows « Pronos-DataPipeline » (07:00) ou cron.
FOOTBALL_DATA_UK_ENABLED=true
# ClubElo (api.clubelo.com) — ratings Elo pré-match, sans clé (même pipeline).
CLUBELO_ENABLED=true
# NOTE Sofascore : si l'IP du déploiement est bannie (403/429), le scraper
# applique SOFASCORE_COOLDOWN_MS puis un bypass Puppeteer. La rotation d'IP
# (proxy/Render) est le seul vrai déblocage d'un bannissement IP.

# ─── Odds — sources PAYANTES (désactivées par défaut) ──
# Met à false pour n'utiliser que les sources gratuites.
BSD_ENABLED=false
THERUNDOWN_ENABLED=false
ODDSPAPI_ENABLED=false
SPORTMONKS_ENABLED=false
APIFOOTBALL_ENABLED=false
BIGBALLS_ENABLED=false
PREDIXSPORT_ENABLED=false
SPORTAPI_ENABLED=false
RAPIDAPI_ENABLED=false
# Clés payantes (ne pas remplir si vous restez 100% gratuit)
BSD_API_KEY=
THERUNDOWN_KEY=
ODDSPAPI_KEY=
SPORTMONKS_KEY=
APIFOOTBALL_KEY=
BIGBALLS_KEY=
