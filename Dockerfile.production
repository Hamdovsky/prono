FROM node:22-slim
WORKDIR /app

# Python + ML packages (use apt where possible, pip --break-system-packages for rest)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip build-essential \
    python3-pandas python3-numpy python3-sklearn python3-joblib \
    && ln -s /usr/bin/python3 /usr/bin/python \
    && python3 -m pip install --no-cache-dir --break-system-packages xgboost optuna \
    && python3 -c "import pandas, numpy, sklearn, xgboost, joblib, optuna; print('ML stack OK')" \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm ci && npm rebuild better-sqlite3
COPY . .
RUN npm rebuild better-sqlite3
RUN npm run build
RUN mkdir -p /app/logs /app/data

ENV NODE_ENV=production
ENV PORT=10000
ENV PYTHONUNBUFFERED=1

EXPOSE 10000

CMD node --max-old-space-size=512 server.js
