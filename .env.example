# ============================================================
#  TITANIUM AI — Variables d'Environnement DOCKER
#  Copier ce fichier en .env et remplir les valeurs réelles
# ============================================================

# ── SERVEUR NODE ────────────────────────────────────────────
PORT=3001
NODE_ENV=production
API_SECRET_KEY=CHANGER_MOI_CLEF_SECRETE_LONGUE_256BIT

# ── BASE DE DONNÉES PostgreSQL / TimescaleDB ─────────────────
DB_HOST=postgres-timescale
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=titanium_pass
DB_NAME=titanium_quant

# ── REDIS CACHE ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=titanium_redis
REDIS_URL=redis://:titanium_redis@redis:6379

# ── FASTAPI ML ENGINE ────────────────────────────────────────
INFERENCE_URL=http://fastapi-ml:8000
PYTHON_PATH=/usr/bin/python3

# ── BOT TELEGRAM ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_BOT
TELEGRAM_CHAT_ID=VOTRE_CHAT_ID

# ── OPTIONS SYSTÈME ──────────────────────────────────────────
DISABLE_BACKUP=false
FRONTEND_URL=*

# ── FOOTBALL DATA API (HTTP Scraper Fallback #1) ───────────────
# Sign up: https://www.football-data.org/client/register
# Free tier: 10 requests/min, 1000/month
FOOTBALLDATA_ENABLED=true
FOOTBALLDATA_KEY=VOTRE_FOOTBALLDATA_KEY
FOOTBALLDATA_DAILY_LIMIT=20

# ── RAPIDAPI (HTTP Scraper Fallback #2 + Sofascore Proxy) ─────
# Two APIs available with the same key:
#   - "API-Football" (api-football-v1.p.rapidapi.com) — matches, odds, H2H
#   - "Sportapi7" (sportapi7.p.rapidapi.com) — Sofascore proxy
# Sign up: https://rapidapi.com/auth/sign-up
# Subscribe to both APIs in RapidAPI Hub
RAPIDAPI_ENABLED=true
RAPIDAPI_KEY=VOTRE_RAPIDAPI_KEY
RAPIDAPI_HOST=sportapi7.p.rapidapi.com
RAPIDAPI_DAILY_LIMIT=20

# ── HTTP SCRAPER (Browserless fallback, no Puppeteer) ─────────
# Uses API-Football + football-data.org to fetch matches
# Works on Render free tier without Chrome/Chromium
HTTP_SCRAPER_ENABLED=true

# ── BLUESMINDS AI (Free LLM Gateway) ──────────────────────────
# Register: https://bluesminds.com
# OpenAI-compatible, 200+ models, free daily credits
# Replaces DeepSeek/Groq for tactical briefing
BLUESMINDS_API_KEY=VOTRE_BLUESMINDS_API_KEY
BLUESMINDS_MODEL=deepseek-chat

# ── BSD BZZOIRO SPORTS DATA (Free Football API) ──────────────
# Register: https://sports.bzzoiro.com
# Free football data: fixtures, predictions, odds, stats, injuries
# No rate limits, 17+ bookmaker odds
BSD_ENABLED=true
BSD_API_KEY=VOTRE_BSD_API_KEY
BSD_BASE_URL=https://sports.bzzoiro.com/api

# ── THERUNDOWN.IO (Free Odds API) ────────────────────────────
# Register: https://therundown.io
# Free: 20,000 data points/day, 1 req/s, 3 sportsbooks
# Soccer sport IDs: 10-19, 33
THERUNDOWN_ENABLED=true
THERUNDOWN_KEY=VOTRE_THERUNDOWN_KEY

# ── ODDS PAPI (Free Odds API, 250 req/month) ─────────────────
# Register: https://oddspapi.io
# Soccer sportId=10, Pinnacle odds included
# Free tier: 250 requests/month, all 350+ bookmakers
ODDSPAPI_ENABLED=true
ODDSPAPI_KEY=VOTRE_ODDSPAPI_KEY

# ── SPORTMONKS (Free Football API, comprehensive data) ───────
# Register: https://sportmonks.com
# Football data: fixtures, odds, standings, stats, H2H, predictions
# Free tier available with limited requests
SPORTMONKS_ENABLED=true
SPORTMONKS_KEY=VOTRE_SPORTMONKS_KEY

# ── API-FOOTBALL (API-Sports, direct subscription) ───────────
# Register: https://dashboard.api-football.com
# Base URL: https://v3.football.api-sports.io
# Auth: x-apisports-key header (NOT RapidAPI)
# Free: 100 requests/day on basic plan
# Endpoints: /fixtures, /odds, /predictions, /leagues
APIFOOTBALL_ENABLED=true
APIFOOTBALL_KEY=VOTRE_APIFOOTBALL_KEY

# ── SUPABASE (PostgreSQL cloud, persistent data) ──────────────
# Register: https://supabase.com (free 500MB database)
# Your DB URI: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Important: URL-encode special chars in password (% for %, ! for %21, etc.)
SUPABASE_ENABLED=true
SUPABASE_URL=postgresql://postgres:VOTRE_PASSWORD@db.VOTRE_PROJECT.supabase.co:5432/postgres

# ── OPENLIGADB (Free football API, no key required) ───────────
# OpenLigaDB — free, no API key required, covers German leagues + UCL/UEL
# https://api.openligadb.de
OPENLIGADB_ENABLED=true

# ── BIG BALLS DATA (xG, stats, odds, lineups, 1000 req/day free) ───
# Sign up: https://bigballsdata.com/signup (no credit card)
# Covers: Premier League, La Liga, Bundesliga, Serie A, Ligue 1, UCL, MLS
BBS_ENABLED=true
BBS_API_KEY=VOTRE_BBS_API_KEY

# ── ODDS-API.IO (Backup odds, 100 req/hour free) ─────────────────
# Sign up: https://odds-api.io (no credit card)
ODDSAPI_IO_ENABLED=true
ODDSAPI_IO_KEY=VOTRE_ODDSAPI_IO_KEY

# ── PREDIXSPORT API (Free football predictions, 200 req/month) ───
# Sign in with Google: https://www.predixsport.com/api-access
# Free tier: 200 requests/month, covers Serie A, Premier League, La Liga, Bundesliga, Ligue 1
# Returns: 1X2, O/U 2.5, BTTS, corners, shots probabilities
PREDIXSPORT_ENABLED=true
PREDIXSPORT_API_KEY=VOTRE_PREDIXSPORT_API_KEY

# ── OPENWEATHERMAP (Weather data for match predictions) ──────
# Register: https://home.openweathermap.org/users/sign_up
# Free: 60 calls/min, 1,000,000 calls/month
# Endpoint: api.openweathermap.org/data/2.5/weather (free)
OPENWEATHER_ENABLED=true
OPENWEATHER_KEY=VOTRE_OPENWEATHER_KEY

VITE_API_URL=http://localhost:3001

# ── FASTAPI INFERENCE (Python / XGBoost) ───────────────────────
# Adresse du service Python FastAPI (Render local ou Railway externe)
INFERENCE_URL=http://127.0.0.1:8000
