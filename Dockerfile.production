# ─── Stage 1: Frontend build ────────────────────────────────
FROM node:18-slim AS frontend-build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --only=production
COPY vite.config.js index.html ./
COPY src/ ./src/
COPY public/ ./public/
RUN npm run build

# ─── Stage 2: Production image ──────────────────────────────
FROM nikolaik/python-nodejs:python3.11-nodejs18
WORKDIR /app

# Copy frontend build
COPY --from=frontend-build /app/dist ./dist

# Copy application code
COPY package.json package-lock.json* ./
COPY app.js server.js ./
COPY core/ ./core/
COPY routes/ ./routes/
COPY services/ ./services/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY data/ ./data/
COPY models/ ./models/
COPY inference/ ./inference/

RUN mkdir -p /app/logs /app/data

# Install npm deps at runtime for faster build
RUN npm ci --only=production && npm rebuild better-sqlite3

ENV NODE_ENV=production
ENV PORT=10000
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/core:/app

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:10000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

EXPOSE 10000

CMD python scripts/import_promosport_archive.py && node --max-old-space-size=512 server.js
