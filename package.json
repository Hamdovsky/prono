    "build": "vite build",
    "preview": "vite preview",
    "db:optimize": "node scripts/optimize_db.js",
    "cleanup:dry": "node tools/cleanup_root.js --dry",
    "cleanup": "node tools/cleanup_root.js",
    "optimize": "npm run db:optimize && npm run build",
    "learn": "node scripts/adaptive_learning_sync.js",
    "dispatch": "node scripts/surgical_daily_dispatch.js",
    "results": "node scripts/surgical_results_report.js",
    "autolearn": "python scripts/train_xgboost.py",
    "online:update": "node scripts/online_learning_update.js",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "sportdb:import": "node scripts/import_sportdb_history.js"
  },
